# Search-time transforms referenced by props-linux.conf.example.
# Merge these stanzas into transforms.conf on the search tier.

[linux_auditd_header]
REGEX = ^type=([A-Z0-9_]+)\s+msg=audit\((\d+(?:\.\d+)?):(\d+)\):
FORMAT = audit_type::$1 audit_epoch::$2 audit_serial::$3

[linux_auditd_result]
REGEX = \b(?:res|success)=["']?(success|failed|yes|no|1|0)(?:["']|\s|$)
FORMAT = audit_result::$1

[linux_auditd_account]
REGEX = \bacct=("?)([^"\s]+)\1(?:\s|$)
FORMAT = audit_account::$2

[linux_auditd_operation]
REGEX = \bop=([^\s]+)
FORMAT = audit_operation::$1

[linux_auditd_address]
REGEX = \baddr=([^\s']+)
FORMAT = audit_address::$1

[linux_rsyslog_header]
REGEX = ^(?:<\d+>)?(\d{4}-\d{2}-\d{2}T\S+)\s+([A-Za-z0-9_.-]+)\s+([A-Za-z0-9_.@/-]+)(?:\[(\d+)\])?:\s+(.*)$
FORMAT = dest::$2 dvc::$2 app::$3 process_id::$4 message::$5

[linux_rsyslog_ssh_auth]
REGEX = (?i)\b(Accepted|Failed)\s+(\S+)\s+for\s+(?:invalid user\s+)?(\S+)\s+from\s+(\S+)\s+port\s+(\d+)
FORMAT = linux_auth_result::$1 linux_auth_method::$2 linux_auth_user::$3 linux_src::$4 linux_src_port::$5

[linux_rsyslog_sudo]
REGEX = \bsudo(?:\[\d+\])?:\s+(\S+)\s*:\s+.*?USER=(\S+)\s*;\s+COMMAND=(.+)$
FORMAT = linux_sudo_actor::$1 linux_sudo_target::$2 linux_command::$3

[linux_rsyslog_account_change]
REGEX = \buseradd(?:\[\d+\])?:\s+new user:\s+name=([^,\s]+),\s+UID=(\d+)
FORMAT = linux_target_user::$1 linux_target_uid::$2

[linux_rsyslog_systemd_service]
REGEX = \bsystemd(?:\[\d+\])?:\s+(Started|Stopped|Failed)\s+([^\s]+\.service)\b
FORMAT = linux_service_state::$1 linux_service_name::$2
